#!/usr/bin/env python3
"""termainal - a fake Linux terminal hallucinated by a local LLM (via Ollama).

Nothing you type is ever executed. Go ahead, sudo rm -rf / --no-preserve-root.
"""

import json
import os
import platform
import random
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request

try:
    import readline  # arrow keys + history for input()
except ImportError:
    readline = None

VERSION = "1.1.0"
CONFIG_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "termainal")
CONFIG_PATH = os.path.join(CONFIG_DIR, "config.json")
HISTORY_PATH = os.path.join(CONFIG_DIR, "history")
OLLAMA_HOST = os.environ.get("OLLAMA_HOST", "http://localhost:11434")
if not OLLAMA_HOST.startswith("http"):
    OLLAMA_HOST = "http://" + OLLAMA_HOST

MAX_HISTORY_CHARS = 24000   # rough cap on the conversation sent back when memory is on
MAX_STORED_OUTPUT = 2500    # long outputs are truncated in that history
FENCE_RE = re.compile(r"^\s*```[\w-]*\s*$")
JUNK_RE = re.compile(r"^\s*(\[cwd:[^\]]*\]|<<\s*cwd:[^>]*>*)\s*", re.I)

TTY = sys.stdout.isatty()
C = {"reset": "\033[0m", "bold": "\033[1m", "dim": "\033[2m", "green": "\033[32m",
     "blue": "\033[34m", "cyan": "\033[36m", "red": "\033[31m", "yellow": "\033[33m"}


def c(text, *styles):
    return "".join(C[s] for s in styles) + text + C["reset"] if TTY else text


# --------------------------------------------------------------------------- specs

FAKE_DEFAULTS = {
    "os": "Pop!_OS 24.04 LTS x86_64",
    "host": "A520M K -CF",
    "kernel": "7.2.6-76070206-generic",
    "packages": "3678 (dpkg), 54 (flatpak), 8 (snap)",
    "shell": "bash 5.2.21",
    "resolution": "2560x1440",
    "de": "COSMIC",
    "theme": "Breeze [GTK2/3]",
    "icons": "breeze-dark [GTK2/3]",
    "terminal": "cosmic-term",
    "cpu": "AMD Ryzen 5 5500 (12) @ 4.268GHz",
    "gpu": "NVIDIA GeForce RTX 3060 Lite Hash Rate",
    "memory_mib": "15857",
}
SPEC_LABELS = [("os", "OS"), ("host", "Host"), ("kernel", "Kernel"), ("packages", "Packages"),
               ("shell", "Shell"), ("resolution", "Resolution"), ("de", "DE"), ("theme", "Theme"),
               ("icons", "Icons"), ("terminal", "Terminal"), ("cpu", "CPU"), ("gpu", "GPU"),
               ("memory_mib", "Total RAM (MiB)")]


def _read(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return ""


def _cmd(*args):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=3).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def real_specs():
    """Best-effort neofetch-style facts about the machine termainal is running on."""
    s = {}
    osr = dict(re.findall(r'^(\w+)="?([^"\n]*)"?$', _read("/etc/os-release"), re.M))
    s["os"] = f"{osr.get('PRETTY_NAME', platform.system())} {platform.machine()}"
    s["host"] = _read("/sys/devices/virtual/dmi/id/product_name")
    if not s["host"] or "to be filled" in s["host"].lower():
        s["host"] = _read("/sys/devices/virtual/dmi/id/board_name")
    s["kernel"] = platform.release()

    pk = []
    dpkg = _read("/var/lib/dpkg/status").count("Status: install ok installed")
    if dpkg:
        pk.append(f"{dpkg} (dpkg)")
    for tool, args in (("rpm", ("rpm", "-qa")), ("pacman", ("pacman", "-Qq")),
                       ("flatpak", ("flatpak", "list", "--app")), ("snap", ("snap", "list"))):
        if shutil.which(tool):
            n = len(_cmd(*args).splitlines()) - (1 if tool == "snap" else 0)
            if n > 0:
                pk.append(f"{n} ({tool})")
    s["packages"] = ", ".join(pk)

    shell = os.path.basename(os.environ.get("SHELL", "bash"))
    ver = re.search(r"\d+\.\d+(\.\d+)?", _cmd(shell, "--version"))
    s["shell"] = f"{shell} {ver.group(0)}" if ver else shell

    res = re.search(r"current (\d+) x (\d+)", _cmd("xrandr", "--current")) if shutil.which("xrandr") else None
    s["resolution"] = f"{res.group(1)}x{res.group(2)}" if res else ""
    s["de"] = os.environ.get("XDG_CURRENT_DESKTOP", "").replace("pop:", "")
    s["terminal"] = os.environ.get("TERM_PROGRAM") or _terminal_name()

    cpuinfo = _read("/proc/cpuinfo")
    model = re.search(r"model name\s*:\s*(.*)", cpuinfo)
    cores = os.cpu_count() or 1
    khz = _read("/sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq")
    cpu = re.sub(r"\s+\d+-Core Processor|\(R\)|\(TM\)| CPU", "", model.group(1)).strip() if model else platform.processor()
    s["cpu"] = f"{cpu} ({cores})" + (f" @ {int(khz) / 1e6:.3f}GHz" if khz.isdigit() else "")

    gpus = []
    for line in _cmd("lspci").splitlines():
        if re.search(r"VGA|3D controller|Display controller", line):
            name = line.split(": ", 1)[-1]
            bracket = re.findall(r"\[([^\]]+)\]", name)
            vendor = name.split()[0]
            gpus.append(f"{vendor} {bracket[-1]}" if bracket else name)
    s["gpu"] = " / ".join(gpus)

    mem = re.search(r"MemTotal:\s*(\d+)", _read("/proc/meminfo"))
    s["memory_mib"] = str(int(mem.group(1)) // 1024) if mem else "16000"
    return {k: v for k, v in s.items() if v}


def _terminal_name():
    try:  # termainal -> shell -> terminal emulator
        pid = os.getppid()
        for _ in range(2):
            pid = int(_read(f"/proc/{pid}/stat").rsplit(")", 1)[1].split()[1])
        return _read(f"/proc/{pid}/comm")
    except (ValueError, IndexError):
        return ""


def specs_for(cfg):
    if cfg.get("specs_mode") == "real":
        return real_specs()
    return {**FAKE_DEFAULTS, **cfg.get("fake_specs", {})}


# --------------------------------------------------------------------------- config

def load_config():
    try:
        with open(CONFIG_PATH) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def save_config(cfg):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(CONFIG_PATH, "w") as f:
        json.dump(cfg, f, indent=2)


def ollama_models():
    with urllib.request.urlopen(OLLAMA_HOST + "/api/tags", timeout=5) as r:
        return sorted(m["name"] for m in json.load(r).get("models", []))


def ask(question, default=None):
    suffix = f" [{default}]" if default else ""
    while True:
        try:
            ans = input(c(question, "bold") + suffix + " ").strip()
        except EOFError:
            print()
            sys.exit(0)
        if ans:
            return ans
        if default is not None:
            return default


def ask_yes(question, default):
    ans = ask(question + (" (Y/n)" if default else " (y/N)"), "").lower()
    return default if not ans else ans.startswith("y")


def setup(cfg=None):
    cfg = dict(cfg or {})
    print(c("\n termainal setup", "bold", "cyan"), c(f"v{VERSION}", "dim"))
    print(c(" A fake terminal powered by a local model. Nothing you type is really run.\n", "dim"))

    try:
        models = ollama_models()
    except (urllib.error.URLError, OSError):
        print(c(f"Can't reach Ollama at {OLLAMA_HOST}.", "red"))
        print("Install it from https://ollama.com and make sure it's running (`ollama serve`).")
        sys.exit(1)
    if not models:
        print(c("Ollama has no models installed.", "red"))
        print("Grab one first, e.g.:  ollama pull qwen2.5:3b")
        sys.exit(1)

    for i, name in enumerate(models, 1):
        mark = c("  (current)", "dim") if name == cfg.get("model") else ""
        print(f"  {c(str(i), 'cyan')}) {name}{mark}")
    default_idx = str(models.index(cfg["model"]) + 1) if cfg.get("model") in models else "1"
    while True:
        pick = ask("which model do you want to use?", default_idx)
        if pick.isdigit() and 1 <= int(pick) <= len(models):
            cfg["model"] = models[int(pick) - 1]
            break
        if pick in models:
            cfg["model"] = pick
            break
        print(c("  pick a number from the list", "yellow"))

    cfg["hostname"] = re.sub(r"\s+", "-", ask("machine name?", cfg.get("hostname", "termainal")))
    cfg["username"] = re.sub(r"\s+", "-", ask("username?", cfg.get("username") or os.environ.get("USER", "user")))

    print(c("\n  1) real   - use this PC's actual specs (read locally, only sent to Ollama)", "dim"))
    print(c("  2) fake   - make up your own", "dim"))
    mode = ask("which specs should the fake machine have?", "2" if cfg.get("specs_mode") == "fake" else "1")
    cfg["specs_mode"] = "fake" if mode.strip().lower() in ("2", "fake", "f") else "real"
    if cfg["specs_mode"] == "fake":
        current = {**FAKE_DEFAULTS, **cfg.get("fake_specs", {})}
        print(c("  press enter to keep each value", "dim"))
        cfg["fake_specs"] = {k: ask(f"  {label}:", current[k]) for k, label in SPEC_LABELS}

    print(c("\n  With memory on, the model sees the whole session, so files you make stick around.", "dim"))
    print(c("  It's slower and small models get confused on long sessions.", "dim"))
    cfg["memory"] = ask_yes("remember session history?", cfg.get("memory", False))

    save_config(cfg)
    print(c(f"\nSaved to {CONFIG_PATH}. Type 'config' to change, 'reset' to wipe the machine, 'exit' to quit.\n", "dim"))
    return cfg


